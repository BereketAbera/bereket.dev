{
  "name": "bereket-dev",
  "private": true,
  "type": "module",
  "description": "Portfolio of Bereket Abera, software engineer (frontend-first, full-stack).",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "npx serve .output/public -l 4173",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
